PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/keitaro_wrapper

# Адрес Keitaro (суффикс /admin можно оставить)
KEITARO_BASE_URL=https://your-tracker.example
# Keitaro Admin -> Профиль -> API-ключи
KEITARO_API_KEY=put_your_api_key_here

# Для названий новых кампаний автоматически добавляется этот префикс
NAME_PREFIX=test_kashkarbaev_
DEFAULT_GROUP_NAME=FORTESTS
DEFAULT_SOURCE_NAME=FORTESTS
DEFAULT_DOMAIN=
GOOGLE_URL=https://www.google.com
KEITARO_TIMEOUT=20000

# Необязательно: путь к старой SQLite-БД для импорта
LEGACY_SQLITE_PATH=./app.db
